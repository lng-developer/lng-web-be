# Application
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Authentication
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
AUTH_REGISTER_ENABLED=false

# Bootstrap admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Primary database
MONGODB_URI=mongodb://localhost:27017/lng_web_be

# Redis
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Public URLs and HR defaults
PUBLIC_API_BASE_URL=
HR_OPERATIONS_TIMEZONE=Asia/Ho_Chi_Minh

# Media storage and Cloudinary
MEDIA_STORAGE_PROVIDER=cloudinary
MEDIA_STORAGE_ROOT=storage/media
MEDIA_UPLOAD_MAX_BYTES=209715200
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lng-system/media
PRODUCTION_SCALED_OUTPUT_STORAGE_PROVIDER=cloudinary

# Legacy HR migration source. Leave empty outside migration and parity checks.
SOURCE_MONGODB_URI=

# SQL attendance
DB_SERVER=
DB_DATABASE=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ATTENDANCE_SCHEMA=dbo
DB_ATTENDANCE_TABLE=CheckInOut
# Current legacy schema uses the composite key UserEnrollNumber + TimeStr.
# Keep this blank until the worker supports compound IDs or SQL exposes one unique event column.
DB_ATTENDANCE_EVENT_ID_COLUMN=
DB_ATTENDANCE_TIMESTAMP_COLUMN=TimeStr
DB_ATTENDANCE_USER_COLUMN=UserEnrollNumber

# Payroll email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
PAYROLL_EMAIL_FROM=
HR_PAYROLL_EMAIL_CONCURRENCY=1
HR_PAYROLL_EMAIL_DELAY_MS=600
HR_PAYROLL_EMAIL_STALE_MS=600000

# Vendor credential security and tracking
VENDOR_CREDENTIAL_SECRET=
VENDOR_WEBHOOK_SECRET=
VENDOR_TRACKING_RECHECK_ENABLED=false
VENDOR_TRACKING_RECHECK_INTERVAL_MS=900000
VENDOR_TRACKING_RECHECK_LIMIT=50

# Lenful
LENFUL_API_BASE_URL=
LENFUL_ACCESS_TOKEN=
LENFUL_STORE_ID=
LENFUL_TRACKING_LIMIT=50

# Merchize
MERCHIZE_API_BASE_URL=
MERCHIZE_ACCESS_TOKEN=
MERCHIZE_IDENTIFIER=lng-web-be

# Printway
PRINTWAY_API_BASE_URL=
PRINTWAY_ACCESS_TOKEN=
PRINTWAY_TRACKING_LIMIT=1
PRINTWAY_TRACKING_PAGE=1
PRINTWAY_TRACKING_CREATED_AT_MIN=
PRINTWAY_TRACKING_CREATED_AT_MAX=

# Smarty address validation
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
SMARTY_LICENSE=

# Operational thresholds and recovery
ORDER_EXPANDED_SLOW_MS=500
PRODUCTION_QUEUE_SLOW_MS=500
STALE_IMPORT_MINUTES=30
STALE_IMPORT_LIMIT=50
