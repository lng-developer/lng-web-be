NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=pretty
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
AUTH_REGISTER_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
MONGODB_URI=mongodb://localhost:27017/lng_web_be
SOURCE_MONGODB_URI=
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lng-system/media
PRODUCTION_SCALED_OUTPUT_STORAGE_PROVIDER=cloudinary

# SQL attendance worker. Credentials stay empty in source control.
DB_SERVER=
DB_DATABASE=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ATTENDANCE_SCHEMA=dbo
DB_ATTENDANCE_TABLE=CHECKINOUT
DB_ATTENDANCE_EVENT_ID_COLUMN=
DB_ATTENDANCE_TIMESTAMP_COLUMN=CHECKTIME
DB_ATTENDANCE_USER_COLUMN=USERID

# Payroll email delivery. Start npm run worker:payroll-email explicitly.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
PAYROLL_EMAIL_FROM=
HR_PAYROLL_EMAIL_CONCURRENCY=1
HR_PAYROLL_EMAIL_DELAY_MS=600
HR_PAYROLL_EMAIL_STALE_MS=600000
