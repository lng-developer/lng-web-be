{
  "name": "lng-web-be",
  "version": "1.0.0",
  "description": "Backend API for the LNG enterprise Print-on-Demand FBM system.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:auth": "npm run seed:rbac && npm run seed:admin",
    "seed:auth:demo": "npm run seed:auth && npm run seed:rbac:demo-scopes",
    "seed:auth:demo-users": "npm run seed:auth:demo && node src/modules/auth/scripts/seedDemoUsers.js",
    "seed:hr:demo-profiles": "node tools/scripts/seed/seedHrDemoProfiles.js",
    "seed:shop:demo": "node tools/scripts/seed/seedShopDemo.js",
    "seed:shop:scopes": "node tools/scripts/maintenance/syncShopScopes.js",
    "seed:organization:demo": "node tools/scripts/seed/seedOrganizationDemo.js",
    "seed:organization:scopes": "node tools/scripts/maintenance/syncOrganizationScopes.js",
    "seed:finance:demo": "node tools/scripts/seed/seedFinanceDemo.js",
    "seed:finance-report:demo": "node tools/scripts/seed/seedDemoFinanceReportData.js",
    "seed:finance-report:demo:apply": "node tools/scripts/seed/seedDemoFinanceReportData.js --apply",
    "reset:finance-report:demo": "node tools/scripts/seed/seedDemoFinanceReportData.js --apply --reset",
    "seed:analytics:demo": "node tools/scripts/seed/seedAnalyticsDemo.js",
    "reset:analytics:demo": "node tools/scripts/seed/seedAnalyticsDemo.js --reset",
    "repair:team-memberships": "node tools/scripts/maintenance/repairTeamMemberships.js",
    "reconcile:employee-profile-departments": "node src/modules/organization/scripts/reconcileEmployeeProfileDepartments.js",
    "seed:demo:full": "npm run seed:auth:demo-users && npm run seed:hr:demo-profiles && npm run seed:organization:demo && npm run seed:shop:demo",
    "seed:demo:relationships": "node tools/scripts/seed/seedRelationshipDemo.js",
    "seed:rbac": "node src/modules/auth/scripts/seedRbac.js",
    "migrate:auth:metadata-fields": "node src/modules/auth/scripts/migrateAuthMetadataFields.js",
    "migrate:auth:remove-user-profiles": "node tools/scripts/maintenance/removeUserProfiles.js",
    "migrate:audit:legacy": "node src/modules/audit/scripts/migrateLegacyAuditEvents.js",
    "migrate:design:listing-variant-index": "node src/modules/design/scripts/migrateActiveDesignTaskIndex.js",
    "migrate:rbac:scoped-role-permissions": "node src/modules/auth/scripts/migrateScopedRolePermissions.js",
    "migrate:rbac:rebalance-assignments": "node src/modules/auth/scripts/rebalanceRoleAssignments.js",
    "migrate:hr:lng-hr": "node src/modules/hr/scripts/migrateLngHrData.js",
    "compare:hr:payroll": "node src/modules/hr/scripts/compareLegacyPayroll.js",
    "audit:hr:readiness": "node src/modules/hr/scripts/auditFullHrReadiness.js",
    "worker:external-order-import": "node src/modules/integration/externalOrderImport/workers/run.js",
    "worker:sql-attendance": "node src/modules/integration/sqlAttendance/workers/sqlAttendance.worker.js",
    "worker:hr-announcements": "node src/modules/hr/workers/announcement.worker.js",
    "worker:payroll-email": "node src/modules/hr/workers/payrollEmail.worker.js",
    "cleanup:auth:sessions": "node src/modules/auth/scripts/cleanupRefreshSessions.js",
    "cleanup:media:multipart": "node src/modules/media/scripts/cleanupMultipartUploads.js",
    "backfill:mapping-cost-estimates": "node src/modules/mapping/scripts/backfillFulfillmentCostEstimates.js",
    "backfill:mapping-plans": "node src/modules/mapping/scripts/backfillFulfillmentPlans.js",
    "backfill:listing-variants": "node src/modules/catalog/scripts/backfillListingVariants.js",
    "cleanup:listings:legacy-fields": "node tools/scripts/maintenance/removeListingLegacyFields.js",
    "backfill:work-scores": "node src/modules/workScore/scripts/backfillWorkScores.js",
    "backfill:customers": "node src/modules/customer/scripts/backfillCustomersFromOrders.js",
    "backfill:order-workbench-projections": "node src/modules/order/scripts/backfillOrderWorkbenchProjections.js",
    "backfill:finance-snapshots": "node tools/scripts/maintenance/backfillFinanceSnapshots.js",
    "backfill:finance-snapshot-ordered-at": "node tools/scripts/maintenance/backfillFinanceSnapshotOrderedAt.js",
    "setup:psd-vendor-readiness": "node tools/scripts/maintenance/applyPsdVendorReadiness.js",
    "indexes:audit": "node src/modules/audit/scripts/ensureAuditIndexes.js",
    "indexes:chat": "node src/modules/chat/scripts/ensureChatIndexes.js",
    "audit:mongo-indexes": "node -r dotenv/config tools/scripts/audit/auditMongoIndexes.js",
    "audit:mongo-fields": "node -r dotenv/config tools/scripts/audit/auditMongoFields.js",
    "audit:vendor-products:canonical": "node -r dotenv/config src/modules/vendor/scripts/vendorProductCanonicalization.js",
    "migrate:vendor-provider-integrations": "node -r dotenv/config src/modules/vendor/scripts/migrateVendorProviderKeysToIntegrations.js",
    "api:inventory": "node tools/api-contract/routeInventory.js",
    "api:contracts:check": "node tools/api-contract/validateApiContracts.js",
    "benchmark:uploads": "node -r dotenv/config tools/scripts/benchmarks/benchmarkUploads.js",
    "benchmark:catalog-get-read-path": "node tools/scripts/benchmarks/catalogGetReadPath.js",
    "indexes:reduce": "node -r dotenv/config tools/scripts/maintenance/applyMongoIndexReduction.js",
    "indexes:reconcile:batch2": "node -r dotenv/config tools/scripts/maintenance/applyMongoIndexReconciliationBatch2.js",
    "indexes:vendor-submissions": "node src/modules/vendorSubmission/scripts/ensureVendorSubmissionIndexes.js",
    "indexes:shipments": "node src/modules/shipment/scripts/ensureShipmentIndexes.js",
    "indexes:extension-commands": "node src/modules/integration/extensionCommand/scripts/ensureExtensionCommandIndexes.js",
    "indexes:catalog": "node src/modules/catalog/scripts/ensureCatalogIndexes.js",
    "indexes:finance-import": "node src/modules/finance/scripts/ensureFinanceImportIndexes.js",
    "recover:post-import-mapping": "node tools/scripts/maintenance/recoverPostImportMappings.js",
    "repair:production-variant-links": "node src/modules/production/scripts/repairListingVariantLinks.js",
    "setup:legacy:build": "node tools/scripts/setup/buildLegacySetupSeeds.js",
    "setup:legacy:import": "node tools/scripts/setup/importLegacySetupSeeds.js",
    "setup:legacy:audit": "node tools/scripts/setup/auditSetupReadiness.js",
    "setup:etsy-nk": "node tools/scripts/setup/seedEtsyNkReadiness.js",
    "seed:rbac:demo-scopes": "node src/modules/auth/scripts/seedDemoScopes.js",
    "seed:admin": "node src/modules/auth/scripts/seedAdmin.js",
    "test:auth": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/auth",
    "test:organization": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/organization",
    "test:shop": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/shop",
    "test:shared": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/shared",
    "test:architecture": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/architecture/architecture.contract.test.js",
    "load:smoke": "k6 run tests/load/smoke.js",
    "load:expected": "k6 run tests/load/expected-load.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --maxWorkers=2",
    "test:full": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --maxWorkers=2",
    "test:changed": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --maxWorkers=2 --findRelatedTests",
    "test:open-handles": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:etsy-flow": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/e2e/etsyOrderFlow.persistence.test.js tests/integration/externalOrderImport/sources/manualExcel/etsySoldOrderItems.mapper.test.js tests/customization/parsers/etsyCustomization.parser.test.js tests/order/services/etsyOrderStatus.service.test.js tests/order/services/etsyListingImage.service.test.js tests/media/services/etsyListingImage.service.test.js tests/customization/services/customizationZipInspect.service.test.js tests/vendorSubmission/services/vendorSubmission.service.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lng-developer/lng-web-be.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lng-developer/lng-web-be/issues"
  },
  "homepage": "https://github.com/lng-developer/lng-web-be#readme",
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>[\\\\/]\\.worktrees[\\\\/]"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>[\\\\/]\\.worktrees[\\\\/]"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "bullmq": "^5.78.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.2.0",
    "imapflow": "^1.7.6",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.16",
    "mongoose": "^9.9.0",
    "mssql": "^12.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.5",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
