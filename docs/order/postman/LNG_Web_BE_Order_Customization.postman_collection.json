        {
          "name": "List Customization Payloads",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.data && json.data.items && json.data.items[0];",
                  "if (first && first.id) {",
                  "  pm.collectionVariables.set('payloadId', first.id);",
                  "}",
                  "if (first && first.orderItemId) {",
                  "  pm.collectionVariables.set('orderItemId', first.orderItemId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customizations?page=1&limit=20&shopId={{shopId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customizations"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "shopId",
                  "value": "{{shopId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Customization Payload",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customizations/{{payloadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customizations",
                "{{payloadId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('review field exists', function () {",
                  "  pm.expect(json.data).to.have.property('review');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Customization Review By Order Item",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customizations/order-items/{{orderItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customizations",
                "order-items",
                "{{orderItemId}}"
              ]
            },
            "description": "Returns review/customerInputs/extractedImages for an order item."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('payloadId', json.data.id);",
                  "}",
                  "pm.test('review field exists', function () {",
                  "  pm.expect(json.data).to.have.property('review');",
                  "});",
                  "pm.test('customer image links are exposed when available', function () {",
                  "  const images = json.data.extractedImages || [];",
                  "  images.forEach((image) => pm.expect(image).to.have.property('secureUrl'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Pending Customization Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.payload && json.data.payload.id) {",
                  "  pm.collectionVariables.set('payloadId', json.data.payload.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderItemId\": \"{{orderItemId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"shopId\": \"{{shopId}}\",\n  \"source\": \"AMAZON_EXTENSION_REPORT\",\n  \"rawRecordId\": \"{{rawRecordId}}\",\n  \"rawCustomization\": {\n    \"name\": \"Jane\",\n    \"imageUrl\": \"https://example.test/design.png\"\n  },\n  \"assets\": [\n    {\n      \"sourceUrl\": \"https://example.test/design.png\",\n      \"type\": \"IMAGE\",\n      \"status\": \"PENDING\",\n      \"metadata\": {}\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customizations/pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customizations",
                "pending"
              ]
            }
          }
        },
