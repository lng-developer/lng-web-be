{
  "info": {
    "_postman_id": "9e2f8a4b-4b3f-4e07-95f4-9dfc7a96c201",
    "name": "LNG Web BE - Shop",
    "description": "Shop core domain endpoints. Shop is an internal business aggregate and does not contain platform connection fields.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "change-me-strong-password",
      "type": "string"
    },
    {
      "key": "shopId",
      "value": "660000000000000000000201",
      "type": "string"
    },
    {
      "key": "inactiveShopId",
      "value": "660000000000000000000204",
      "type": "string"
    },
    {
      "key": "suspendedShopId",
      "value": "660000000000000000000205",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.accessToken) {",
              "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "}",
              "if (json.data && json.data.refreshToken) {",
              "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Shop Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/shops/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops",
            "health"
          ]
        }
      }
    },
    {
      "name": "List Shops",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/shops?page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "List Active Shops By Search",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/shops?status=ACTIVE&search=Foot&page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops"
          ],
          "query": [
            {
              "key": "status",
              "value": "ACTIVE"
            },
            {
              "key": "search",
              "value": "Foot"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Create Shop",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('shopId', json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Veteran Gift Shop\",\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shops",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops"
          ]
        },
        "description": "Requires global SHOPS:WRITE. Creates a core shop and syncs it to Auth ScopeRegistry."
      }
    },
    {
      "name": "Get Shop Detail",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/shops/{{shopId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops",
            "{{shopId}}"
          ]
        }
      }
    },
    {
      "name": "Set Shop Inactive",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shops/{{shopId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops",
            "{{shopId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Set Shop Active",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/shops/{{shopId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops",
            "{{shopId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Get Inactive Shop - Expected 409",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/shops/{{inactiveShopId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shops",
            "{{inactiveShopId}}"
          ]
        },
        "description": "Expected 409 because business flow detail uses shopPublic.assertShopIsActive."
      }
    }
  ]
}
