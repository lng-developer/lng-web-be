            "integration",
            "external-order-imports",
            "{{jobId}}",
            "raw-records"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const firstImported = json.data && json.data.items && json.data.items.find((item) => item.orderItemId);",
              "if (firstImported) {",
              "  pm.collectionVariables.set('orderItemId', firstImported.orderItemId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Customization Review By Order Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('payloadId', json.data.id);",
              "}",
              "pm.test('review field exists', function () {",
              "  pm.expect(json.data).to.have.property('review');",
              "});",
              "pm.test('customer image links are exposed when available', function () {",
              "  const images = json.data.extractedImages || [];",
              "  images.forEach((image) => pm.expect(image).to.have.property('secureUrl'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customizations/order-items/{{orderItemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customizations",
            "order-items",
            "{{orderItemId}}"
          ]
        },
        "description": "Returns review/customerInputs/extractedImages for the imported order item."
      }
