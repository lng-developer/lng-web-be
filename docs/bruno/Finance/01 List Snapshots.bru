meta {
  name: List Snapshots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/finance/snapshots
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  ~shopId: {{shopId}}
  ~orderId: {{orderId}}
  ~orderItemId: {{orderItemId}}
  ~salesChannelCode: AMAZON
  ~marketplaceCode: AMAZON_US
  ~snapshotStatus: ESTIMATED
  ~costStatus: PRESENT
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-11
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
