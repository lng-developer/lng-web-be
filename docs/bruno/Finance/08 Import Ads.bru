meta {
  name: Import Ads
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/finance/imports/ads
  body: multipartForm
  auth: none
}

params:query {
  shopId: {{shopId}}
  salesChannelCode: AMAZON
  marketplaceCode: AMAZON_US
  dryRun: true
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:multipart-form {
  file: @file({{financeImportFilePath}})
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
