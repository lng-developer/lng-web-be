meta {
  name: Create Team
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/organization/teams
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Team",
    "code": "BRUNO_TEAM",
    "departmentId": "{{departmentId}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
