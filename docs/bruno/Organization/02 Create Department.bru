meta {
  name: Create Department
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/organization/departments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Department",
    "code": "BRUNO_DEPT"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
