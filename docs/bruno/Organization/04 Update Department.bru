meta {
  name: Update Department
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/organization/departments/{{departmentId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Department Updated",
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
