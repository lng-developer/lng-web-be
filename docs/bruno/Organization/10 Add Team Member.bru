meta {
  name: Add Team Member
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/organization/teams/{{teamId}}/members
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "accountId": "{{accountId}}",
    "memberType": "MEMBER"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
