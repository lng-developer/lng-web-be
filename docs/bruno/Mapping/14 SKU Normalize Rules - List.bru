meta {
  name: SKU Normalize Rules - List
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/mapping/sku-normalize-rules
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  ~shopId: {{shopId}}
  ~salesChannelCode: AMAZON
  ~marketplaceCode: AMAZON_US
  ~status: ACTIVE
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
