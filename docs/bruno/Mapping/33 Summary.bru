meta {
  name: Summary
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/api/mapping/summary
  body: none
  auth: none
}

params:query {
  ~shopId: {{shopId}}
  ~salesChannelCode: AMAZON
  ~marketplaceCode: AMAZON_US
  limit: 50
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
