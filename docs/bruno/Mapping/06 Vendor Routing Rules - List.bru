meta {
  name: Vendor Routing Rules - List
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/mapping/vendor-routing-rules
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  ~shopId: {{shopId}}
  ~salesChannelCode: AMAZON
  ~marketplaceCode: AMAZON_US
  ~productTypeGroupId: {{productTypeGroupId}}
  ~vendorId: {{vendorId}}
  ~status: ACTIVE
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
