meta {
  name: Semantic Rules - Create
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/mapping/semantic-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "shopId": "{{shopId}}",
    "salesChannelCode": "AMAZON",
    "marketplaceCode": "AMAZON_US",
    "semanticRole": "SIZE",
    "matchValue": "Select Your Choose Size",
    "priority": 100,
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
