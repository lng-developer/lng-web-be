meta {
  name: Recheck Unmatched Batch
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/mapping/recheck-unmatched
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "shopId": "{{shopId}}",
    "salesChannelCode": "AMAZON",
    "marketplaceCode": "AMAZON_US",
    "limit": 50
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

