meta {
  name: Vendor Routing Rules - Create
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/mapping/vendor-routing-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "shopId": "{{shopId}}",
    "salesChannelCode": "AMAZON",
    "marketplaceCode": "AMAZON_US",
    "productTypeGroupId": "{{productTypeGroupId}}",
    "vendorId": "{{vendorId}}",
    "priority": 100,
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
