meta {
  name: Fulfillment Select Manual
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/mapping/order-items/{{orderItemId}}/select
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "vendorProductId": "{{vendorProductId}}",
    "vendorCostCenterId": "{{vendorCostCenterId}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
