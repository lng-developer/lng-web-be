meta {
  name: Vendor Routing Rules - Update
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/mapping/vendor-routing-rules/{{vendorRoutingRuleId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "priority": 50,
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
