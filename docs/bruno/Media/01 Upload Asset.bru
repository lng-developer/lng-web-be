meta {
  name: Upload Asset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/media/assets
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:multipart-form {
  file: @file({{designUploadFilePath}})
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
