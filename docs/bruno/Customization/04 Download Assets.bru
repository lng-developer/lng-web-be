meta {
  name: Download Assets
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/customizations/order-items/{{orderItemId}}/download-assets
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "retryFailed": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
