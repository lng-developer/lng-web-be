meta {
  name: Mark Needs Review
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/customizations/{{payloadId}}/needs-review
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "reason": "Marked from Bruno"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
