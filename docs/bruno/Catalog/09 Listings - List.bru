meta {
  name: Listings - List
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/catalog/listings
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  ~shopId: {{shopId}}
  ~salesChannelCode: AMAZON
  ~marketplaceCode: AMAZON_US
  ~sku: TS1S
  ~asin: B0
  ~etsyListingId: 123
  ~status: ACTIVE
  ~qcStatus: APPROVED
  ~productTypeGroupId: {{productTypeGroupId}}
  ~psdStatus: MISSING
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
