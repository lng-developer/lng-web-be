meta {
  name: Listings - Reject
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/catalog/listings/{{listingId}}/reject
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "rejectionReason": "Rejected from Bruno test"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
