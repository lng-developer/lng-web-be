meta {
  name: Internal Templates - Update
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/catalog/internal-templates/{{internalTemplateId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Template Updated",
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
