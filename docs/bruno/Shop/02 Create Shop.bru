meta {
  name: Create Shop
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/shops
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Test Shop",
    "currency": "USD"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
