meta {
  name: List Orders
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/orders
  body: none
  auth: none
}

params:query {
  tab: ALL
  page: 1
  limit: 20
  sort: -orderedAt
  ~shopId: {{shopId}}
  ~orderId: 113
  ~employeeCode: J2510
  ~search: shirt
  ~status: IMPORTED
  ~psdStatus: MISSING
  ~caseStatus: NONE
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-11
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
