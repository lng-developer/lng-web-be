meta {
  name: Create Order Case
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/orders/cases
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "orderId": "{{orderId}}",
    "caseType": "CUSTOMIZATION",
    "severity": "MEDIUM",
    "title": "Customer input needs review",
    "description": "The uploaded image is incomplete."
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
