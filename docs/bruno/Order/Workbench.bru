meta {
  name: Workbench
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/orders/workbench?page=1&limit=10&tab=ALL
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  tab: ALL
  ~shopId: {{shopId}}
  ~orderId: 113
  ~employeeCode: J2510
  ~status: IMPORTED
  ~psdStatus: MISSING
  ~caseStatus: NONE
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-11
  ~search: LOADTEST-20260707030033-000006
  ~page: 1
}

headers {
  Authorization: Bearer {{accessToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}
