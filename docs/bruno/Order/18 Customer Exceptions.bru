meta {
  name: Customer Exceptions
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/orders/customer-exceptions?page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  ~shopId: {{shopId}}
  ~caseType: CUSTOMIZATION
  ~reason: CUSTOMIZATION_NOT_READY
  ~status: MISSING
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-14
}

headers {
  Authorization: Bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
