meta {
  name: Shop User - Login
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "j2531@demo.lng.co",
    "password": "Demo@123456"
  }
}

script:post-response {
  const token = res.getBody()?.data?.accessToken;
  if (token) {
    bru.setEnvVar('shopUserToken', token, { persist: true });
    bru.setVar('shopUserToken', token);
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
