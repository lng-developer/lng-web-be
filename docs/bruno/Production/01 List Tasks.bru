meta {
  name: List Production Tasks
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/production/tasks
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 1
  ~shopId: {{shopId}}
  ~status: NEED_PRODUCTION
  ~scaleStatus: NEED_SCALE
  ~qcStatus: QC_PENDING
  ~assignedDesignUserId: {{assignedDesignUserId}}
  ~scaleBy: {{accountId}}
  ~qcBy: {{accountId}}
  ~assignedDateFrom: 2026-07-01
  ~assignedDateTo: 2026-07-11
  ~readyDateFrom: 2026-07-01
  ~readyDateTo: 2026-07-11
  ~sort: -createdAt
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(200);
    expect(response.body.success).to.equal(true);
  }
}
