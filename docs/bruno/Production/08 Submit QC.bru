meta {
  name: Submit QC
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/production/tasks/{{productionTaskId}}/qc
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "decision": "PASSED",
    "note": "QC from Bruno"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
