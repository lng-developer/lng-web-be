meta {
  name: Mark Sent To Vendor
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/production/tasks/{{productionTaskId}}/sent-to-vendor
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "vendorSubmissionId": null
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
