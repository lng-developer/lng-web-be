meta {
  name: Upload Scaled Output
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/production/tasks/{{productionTaskId}}/file-checks/{{productionFileCheckId}}/scaled-output
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "mediaAssetId": "{{mediaAssetId}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
