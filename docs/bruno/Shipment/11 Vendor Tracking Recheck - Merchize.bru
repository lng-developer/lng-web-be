meta {
  name: Vendor Tracking Recheck - Merchize
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/shipments/vendor-tracking/recheck
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "MERCHIZE",
    "externalOrderId": "{{vendorExternalOrderId}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
