meta {
  name: Summary
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/shipments/summary
  body: none
  auth: none
}

params:query {
  ~shopId: {{shopId}}
  ~status: SHIPPED
  ~carrier: USPS
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
