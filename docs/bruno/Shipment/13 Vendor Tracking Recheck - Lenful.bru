meta {
  name: Vendor Tracking Recheck - Lenful
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/shipments/vendor-tracking/recheck
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "LENFUL",
    "externalOrderId": "{{vendorExternalOrderId}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
