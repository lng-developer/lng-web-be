meta {
  name: Update Tracking
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/shipments/{{shipmentId}}/tracking
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "carrier": "USPS",
    "trackingNumber": "{{trackingNumber}}",
    "trackingUrl": "{{trackingUrl}}",
    "note": "Vendor tracking"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
