meta {
  name: Vendor Tracking Recheck Submitted Item
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/shipments/vendor-tracking/recheck
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "PRINTWAY",
    "externalOrderId": "{{vendorExternalOrderId}}",
    "vendorSubmissionId": "{{vendorSubmissionId}}"
  }
}

assert {
  res.status: in [200, 202]
  res.body.success: eq true
}
