meta {
  name: Tasks - Create IDEA
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/design/tasks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "listingId": "{{listingId}}",
    "taskType": "IDEA",
    "brief": "Create a new concept for this listing",
    "referenceAssetIds": [],
    "expectedOutputs": ["MOCKUP", "PNG_ASSET"],
    "note": "Use attached references if provided"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
