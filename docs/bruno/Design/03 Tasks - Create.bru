meta {
  name: Tasks - Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/design/tasks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "listingId": "{{listingId}}",
    "taskType": "PSD_TEMPLATE",
    "note": "Need PSD master"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
