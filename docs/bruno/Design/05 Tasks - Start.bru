meta {
  name: Tasks - Start
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/design/tasks/{{designTaskId}}/start
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "note": "Started PSD work"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
