meta {
  name: Create PSD Task From Listing
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/design/tasks/from-listings/{{listingId}}/psd-template
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "note": "Need PSD master"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
