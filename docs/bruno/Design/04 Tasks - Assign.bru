meta {
  name: Tasks - Assign
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/design/tasks/{{designTaskId}}/assign
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "assignedDesignerId": "{{assignedDesignUserId}}",
    "note": "Assign PSD task"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
