meta {
  name: Update Vendor Product
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/vendors/products/{{vendorProductId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno Product Updated",
    "baseCostAmount": 1200,
    "currency": "USD",
    "status": "ACTIVE"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
