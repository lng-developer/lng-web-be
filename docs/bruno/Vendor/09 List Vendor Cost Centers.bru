meta {
  name: List Vendor Cost Centers
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/vendors/products/{{vendorProductId}}/cost-centers
  body: none
  auth: none
}

params:query {
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
