meta {
  name: Mark Failed
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/vendor-submissions/{{vendorSubmissionId}}/mark-failed
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "failureReason": "Vendor portal rejected the order"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
