meta {
  name: Create From Production Task
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/vendor-submissions/from-production-tasks/{{productionTaskId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 201
  res.body.success: eq true
}
