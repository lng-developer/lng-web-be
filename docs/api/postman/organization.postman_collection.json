              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organization",
                "departments"
              ]
            },
            "description": "Creates department and syncs Auth ScopeRegistry. Repeated runs may return duplicate code conflict.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Operations Department\",\n  \"code\": \"OPERATIONS\"\n}"
            }
          }
        },
