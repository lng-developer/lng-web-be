              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"fullName\": \"Postman Test User\",\n  \"assignments\": [\n    {\n      \"roleId\": \"{{operatorRoleId}}\",\n      \"scopeType\": \"global\",\n      \"scopeId\": null,\n      \"customPermissionIds\": []\n    }\n  ]\n}"
