              "path": [
                "api",
                "auth",
                "permissions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const permissions = (body.data && body.data.items) || [];",
                  "if (permissions[0]) pm.collectionVariables.set('permissionId', permissions[0].id);",
                  "const ordersRead = permissions.find((permission) => permission.code === 'ORDERS:READ');",
                  "if (ordersRead) pm.collectionVariables.set('ordersReadPermissionId', ordersRead.id);",
                  "if (ordersRead) pm.collectionVariables.set('permissionId', ordersRead.id);"
                ]
              }
            }
          ]
        },
